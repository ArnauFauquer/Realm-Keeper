# Backend sin Docker (uvicorn ... --env-file .env). Ver ../.env.example para
# lo que significa cada opción; aquí, los valores para desarrollo local.

# Las notas: una carpeta. Sin REPO_URL, git está apagado: se escriben como
# ficheros y lo que cambie en disco se recarga cada VAULT_WATCH_INTERVAL s.
VAULT_PATH=./vault
REPO_URL=
# GIT_ENABLED=
# VAULT_WATCH_INTERVAL=10

# Documentos, imágenes y audio: una carpeta (local) o un bucket (s3).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=realm-keeper-audio
# S3_REGION=us-east-1

# Sin login para desarrollar; con true, configura al menos un proveedor
# (OIDC_*, GITHUB_*, GOOGLE_*) y registra como redirección:
#   http://localhost:8000/api/auth/callback
ENABLE_AUTH=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=tu-email@example.com
SESSION_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
