# Configuración del vault de notas markdown
VAULT_PATH=./vault
REPO_URL=

# Si tienes un repositorio de Git con tus notas:
# REPO_URL=https://github.com/tu-usuario/tus-notas.git

# Object storage (Ceph Rook / cualquier S3 compatible) para el reproductor de audio
S3_ENDPOINT_URL=https://rook-ceph-rgw.example.svc:8080
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=realm-keeper-audio
S3_REGION=us-east-1

# Pon esto en false si no quieres proteger tu instancia con login (uso en
# solitario, red local de confianza, etc.). Con false, todas las rutas
# quedan abiertas como un único usuario local: no hace falta configurar
# Google OAuth ni ALLOWED_EMAILS más abajo.
ENABLE_AUTH=true

# Login con Google (sin base de datos: la sesión es una cookie firmada)
#
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea un "OAuth 2.0 Client ID" de tipo "Web application"
# 3. En "Authorized redirect URIs" añade:
#      http://localhost:8000/api/auth/callback   (desarrollo local)
#      https://tu-dominio.com/api/auth/callback   (producción)
# 4. Copia el Client ID y el Client Secret aquí abajo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails con permiso para entrar, separados por comas (case-insensitive)
ALLOWED_EMAILS=tu-email@gmail.com

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacía, se genera una aleatoria al arrancar (válido para probar
# en local, pero en producción invalidaría las sesiones en cada despliegue).
SESSION_SECRET_KEY=

# A dónde redirigir tras un login correcto
FRONTEND_URL=http://localhost:5173

# Se activa solo si FRONTEND_URL empieza por https://. Descoméntalo solo
# para forzarlo en un sentido u otro.
# SESSION_COOKIE_SECURE=false
