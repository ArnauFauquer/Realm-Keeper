# Realm Keeper — configuración de docker compose. Todo es opcional salvo la
# propia app: sin nada más, las notas son una carpeta y el resto (documentos,
# imágenes, audio) va a un volumen local.

# ── Notas ──────────────────────────────────────────────────────────────────
# Opción A: una carpeta (por ejemplo tu vault de Obsidian), leída y escrita
# como ficheros, sin git. Lo que cambies en Obsidian aparece en la app en
# unos segundos (VAULT_WATCH_INTERVAL). El contenedor corre como UID 1000:
# ese usuario tiene que poder escribir la carpeta.
VAULT_DIR=
# VAULT_DIR=/home/tu-usuario/Obsidian/MiCampaña

# Opción B: un repositorio git, que la app clona, sincroniza y en el que hace
# commit + push de cada nota guardada (déjalo vacío para la opción A).
# Para un repo privado de GitHub, un token con permiso de escritura:
#   https://TOKEN@github.com/usuario/repo.git
REPO_URL=
# Con REPO_URL, git está activo. GIT_ENABLED=true sin REPO_URL usa la carpeta
# VAULT_DIR si ya es un clon, con su propio remoto (pull + commit + push).
# GIT_ENABLED=
# GIT_SYNC_INTERVAL=300

# Tag que oculta una nota de la app
NOTE_TAG_IGNORE=draft

# ── Ficheros: documentos, imágenes y audio ──────────────────────────────────
# local (por defecto): un volumen Docker, o la carpeta DATA_DIR.
# s3: cualquier bucket compatible con S3 (MinIO, Ceph RGW, AWS S3...).
STORAGE_BACKEND=local
# DATA_DIR=/srv/realm-keeper-data

# Para levantar también un MinIO aquí mismo:
#   COMPOSE_PROFILES=s3
#   STORAGE_BACKEND=s3
# Para usar un bucket que ya tienes, solo STORAGE_BACKEND=s3 y:
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=realm-keeper-audio
# S3_REGION=us-east-1

# ── Login ──────────────────────────────────────────────────────────────────
# false: sin login, todo abierto como un único usuario local (uso en
# solitario, red de confianza, o para probar).
ENABLE_AUTH=false

# Con login, cada proveedor configurado tiene su botón. En todos, la URL de
# redirección a registrar es la misma: <tu-dominio>/api/auth/callback
#
# Cualquier proveedor OpenID Connect, por su issuer:
#   Microsoft Entra ID  https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak            https://keycloak.example.com/realms/<realm>
#   Authentik           https://authentik.example.com/application/o/<slug>/
#   Authelia, Auth0, Okta, Zitadel, GitLab, Pocket ID... igual: su issuer.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# El nombre del botón: "Sign in with <OIDC_NAME>"
OIDC_NAME=
# OIDC_SCOPES=openid email profile
# Solo para proveedores que nunca envían email_verified y donde solo los
# admins pueden poner un email (un Entra ID de un solo tenant, tu Keycloak):
# OIDC_REQUIRE_VERIFIED_EMAIL=false

# GitHub (OAuth App: Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google (console.cloud.google.com → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails que pueden entrar, separados por comas. El orden fija el color de
# los dados de cada persona.
ALLOWED_EMAILS=tu-email@example.com
# Firma la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
# SESSION_COOKIE_SECURE=  (por defecto: true si FRONTEND_URL es https://)

# Nota que abre la página de inicio (su ruta sin .md). Vacío: la primera de
# RealmKeeper, index, Home, README o Welcome en la raíz del vault.
# HOME_NOTE=

# ── Frontend ───────────────────────────────────────────────────────────────
# Vacío a propósito: nginx.conf redirige /api y /ws al backend, así el
# navegador lo ve todo bajo el mismo origen (necesario para la cookie).
VITE_API_URL=
