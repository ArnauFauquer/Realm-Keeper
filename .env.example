# Repositorio Git con tus notas markdown (opcional)
# Si lo configuras, podrás sincronizar desde la UI
# 
# IMPORTANTE: Para generar un token:
# 1. Ve a GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# 2. Generate new token (classic)
# 3. Selecciona los scopes: repo (Full control of private repositories)
# 4. Copia el token y úsalo en el formato de abajo
#
# Formato: https://TOKEN@github.com/usuario/repo.git
REPO_URL=

# Ejemplo:
# REPO_URL=https://ghp_xxxxxxxxxxxxxxxxxxxx@github.com/tu-usuario/tus-notas.git

# Frontend - Página de inicio por defecto (sin extensión .md)
# La aplicación redirigirá automáticamente a /note/{VITE_DEFAULT_PAGE}
VITE_DEFAULT_PAGE=index

# Frontend - URL del backend API. Vacío a propósito: nginx.conf redirige
# /api y /ws al contenedor del backend, así que el navegador ve todo bajo
# el mismo origen (necesario para la cookie de login).
VITE_API_URL=

# Tag que oculta una nota de la app (debe coincidir con producción, ver
# .argocd/backend-deployment.yaml)
NOTE_TAG_IGNORE=draft

# Object storage (Ceph Rook / cualquier S3 compatible) para el reproductor de audio
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=realm-keeper-audio
S3_REGION=us-east-1

# Login con Google (ver backend/.env.example para instrucciones detalladas)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=tu-email@gmail.com
SESSION_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false
