# Where people open the app. Every provider sends them back to
#   <APP_URL>/api/auth/callback
# which is the redirect (callback) URL to register with each one.
APP_URL=http://localhost:8080

# GitHub: Settings > Developer settings > OAuth Apps > New OAuth App.
#   Homepage URL:               <APP_URL>
#   Authorization callback URL: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: console.cloud.google.com > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application.
#   Authorized redirect URI:    <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in, comma-separated. The order sets each one's dice colour.
ALLOWED_EMAILS=you@example.com,a-player@example.com

# Signs the session cookie. Make one with:  openssl rand -base64 32
SESSION_SECRET_KEY=

# VAULT_DIR=/home/me/Obsidian/My Campaign
# RK_PORT=8080
# REALM_KEEPER_VERSION=latest
