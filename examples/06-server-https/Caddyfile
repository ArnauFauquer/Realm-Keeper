# Caddy gets and renews the HTTPS certificate for DOMAIN by itself (its DNS
# must point at this server, with ports 80 and 443 open).
{$DOMAIN} {
	encode zstd gzip

	# The API and the live sockets go straight to the backend; Caddy tells it
	# the request came over HTTPS (X-Forwarded-Proto), so the login's
	# redirect URI and the cookie are https too.
	@api path /api/* /ws/*
	reverse_proxy @api backend:8000

	reverse_proxy frontend:8080
}
