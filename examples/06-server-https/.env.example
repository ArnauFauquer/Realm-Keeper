# The server's domain name; its DNS must point here.
DOMAIN=rpg.example.com

# The notes repository (a token with write access, for a private one).
REPO_URL=https://<token>@github.com/<user>/<repo>.git

# MinIO's credentials (only reachable inside Docker's network).
S3_ACCESS_KEY=realmkeeper
S3_SECRET_KEY=

# The OpenID Connect provider: its issuer URL, and a client registered there
# with the redirect URI  https://<DOMAIN>/api/auth/callback
#   Keycloak           https://<host>/realms/<realm>
#   Authentik          https://<host>/application/o/<app-slug>/
#   Authelia           https://<host>
#   Microsoft Entra ID https://login.microsoftonline.com/<tenant-id>/v2.0
#                      (and OIDC_REQUIRE_VERIFIED_EMAIL=false: it never sends
#                      email_verified; only with a single-tenant issuer)
#   Auth0              https://<tenant>.auth0.com/
#   GitLab             https://gitlab.com
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The button says "Sign in with <OIDC_NAME>"
OIDC_NAME=Keycloak
# OIDC_REQUIRE_VERIFIED_EMAIL=true

# Who may sign in, comma-separated. The order sets each one's dice colour.
ALLOWED_EMAILS=you@example.com

# Signs the session cookie. Make one with:  openssl rand -base64 32
SESSION_SECRET_KEY=

# REALM_KEEPER_VERSION=latest
