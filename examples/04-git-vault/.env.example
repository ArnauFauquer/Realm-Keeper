# The repository holding your notes. For a private one, put an access token
# with write access in the URL (edits made in the app are pushed):
#   GitHub:  https://<token>@github.com/<user>/<repo>.git
#            (fine-grained token, "Contents: read and write" on that repo)
#   GitLab:  https://oauth2:<token>@gitlab.com/<user>/<repo>.git
REPO_URL=

# Seconds between pulls (0: only at start)
# GIT_SYNC_INTERVAL=300

# RK_PORT=8080
# REALM_KEEPER_VERSION=latest
